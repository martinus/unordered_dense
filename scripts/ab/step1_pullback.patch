# On top of block96.patch: a mask per group, one bit per lane, "placed at step 1", so an erase pulls
# that entry of the next group into the lane it frees (#364). Rejected 2026-10-03, notes
# "A step-1 mask per group".
diff --git a/include/ankerl/unordered_dense.h b/include/ankerl/unordered_dense.h
