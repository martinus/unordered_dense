+    // step1_pullback.patch (#364): m_extra's first two bytes are a mask, one bit per lane, "the entry
+    // here was placed at step 1", so its home is the group before this one.
+    template <typename G>
+    static auto step1_mask(G const& g) -> std::uint16_t {
+        std::uint16_t m{};
+        std::memcpy(&m, g.m_extra.data(), sizeof(m));
+        return m;
+    }
+    template <typename G>
+    static void set_step1_mask(G& g, std::uint16_t m) {
+        std::memcpy(g.m_extra.data(), &m, sizeof(m));
+    }
+
     // The placement for a caller that has already taken the hash apart, and has just probed with
