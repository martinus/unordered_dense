         uncount(groups, mask, home_idx, counter, found_in);
+        auto const next_idx = static_cast<value_idx_type>((found_in + 1U) & mask);
+        auto& next = groups[next_idx];
+        auto const pull = step1_mask(next);
+        if (pull != 0) {
+            auto const from_lane = static_cast<std::uint8_t>(first_lane(pull));
+            auto const fp = next.m_fingerprints[from_lane];
+            freed.m_fingerprints[lane] = fp;
+            freed.m_index[lane] = next.m_index[from_lane];
+            next.m_fingerprints[from_lane] = 0;
+            set_step1_mask(next, static_cast<std::uint16_t>(pull & (pull - 1U)));
+            // it passed `found_in` at step 0 and was counted there, nowhere else
+            uncount(groups, mask, found_in, fp & 7U, next_idx);
+        }
     }
 
