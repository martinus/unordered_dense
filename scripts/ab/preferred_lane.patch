+    place_group(std::uint32_t word, unsigned counter, value_idx_type group_idx, value_idx_type value_idx, unsigned lane = 16) {
         static_assert(!is_view_v, "map_view and set_view are read only");
         auto* groups = m_buckets.data();
+        if (lane < 16 && groups[group_idx].m_fingerprints[lane] == 0) {
+            groups[group_idx].m_fingerprints[lane] = static_cast<std::uint8_t>(word);
+            groups[group_idx].m_index[lane] = value_idx;
+            return;
+        }
         value_idx_type delta = 0;
         while (true) {
             auto& group = groups[group_idx];
@@ -3100,6 +3123,15 @@ private:
             auto const word = fingerprint_word(mh);
             auto const counter = word & 7U;
             auto group_idx = static_cast<value_idx_type>(mh >> shifts);
+            {
+                auto const lane = static_cast<unsigned>(mh >> (shifts - 4U)) & 15U;
+                auto& home = groups[group_idx];
+                if (home.m_fingerprints[lane] == 0) {
