# #347's preferred lane, as a patch against include/ankerl/unordered_dense.h: the four hash bits below
# the group's pick a lane inside the home group; placement takes it when free, and the probe checks that
# lane's fingerprint byte and key before the group compare. Rejected 2026-10-03: dense ids 0.85-0.91 in
# a quiet loop, scrambled integer hits 1.3-1.8x slower. notes/index-design.md "A preferred lane".
# Measured with: AB_BUILD=/home/martinus/gra/x scripts/ab/small_hits.sh 5 origin/main wt (patch applied).
diff --git a/include/ankerl/unordered_dense.h b/include/ankerl/unordered_dense.h
index fbad56c..bf0937b 100644
--- a/include/ankerl/unordered_dense.h
+++ b/include/ankerl/unordered_dense.h
@@ -2275,6 +2275,13 @@ private:
     // 8 so that 0 means empty and (fingerprint & 7), which picks the counter, is unchanged.
 
     // the fingerprint in all four bytes of a word, from the table above
+    // #347 experiment: the four hash bits just below the group's, a lane the key prefers inside its
+    // home group. For keys a multiplicative hash spreads evenly (dense ids) they are as even as the
+    // group bits, so a key nearly always sits in its own lane.
+    [[nodiscard]] auto preferred_lane(std::uint64_t mh) const -> unsigned {
+        return static_cast<unsigned>(mh >> (m_shifts - 4U)) & 15U;
+    }
+
     [[nodiscard]] static constexpr auto fingerprint_word(std::uint64_t hash) -> std::uint32_t {
         return detail::fingerprint_words[hash & 0xFFU];
     }
@@ -2539,6 +2546,17 @@ private:
         auto const word = fingerprint_word(mh);
         auto const counter = word & 7U;
         auto const home_idx = group_idx_from_hash(mh);
+        {
+            // #347: the key's own lane first, a byte compare and the key, before the group compare
+            auto const lane = preferred_lane(mh);
+            auto const& home = m_buckets.data()[home_idx];
+            if (ANKERL_UNORDERED_DENSE_LIKELY(home.m_fingerprints[lane] == static_cast<std::uint8_t>(word))) {
+                auto const value_idx = home.m_index[lane];
+                if (ANKERL_UNORDERED_DENSE_LIKELY(m_equal(key, get_key(m_values[value_idx])))) {
+                    return {home_idx, value_idx, static_cast<std::uint8_t>(lane), true};
+                }
+            }
+        }
         if constexpr (!detail::key_compare_is_call_v<Key>) {
             return probe_from(key, word, counter, home_idx, 0);
         } else {
@@ -2568,16 +2586,21 @@ private:
     // counts it.
     ANKERL_UNORDERED_DENSE_FORCEINLINE void place_group(std::uint64_t mh, value_idx_type value_idx) {
         auto const word = fingerprint_word(mh);
-        place_group(word, word & 7U, group_idx_from_hash(mh), value_idx);
+        place_group(word, word & 7U, group_idx_from_hash(mh), value_idx, preferred_lane(mh));
     }
 
     // The placement for a caller that has already taken the hash apart, and has just probed with
