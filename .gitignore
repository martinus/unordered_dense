build
builddir
.cache
.vscode
compile_commands.json

# ignore all in subprojects except the .wrap files
/subprojects/*
!/subprojects/*.wrap

# c++ modules
*.pcm
a.out
*.o
# local fuzzing output, see scripts/fuzz_afl.py
fuzz-findings/

# left behind by importing anything under scripts/
__pycache__/

# compiler cache, populated by the MinGW CI job
.ccache/

# Core dumps. kernel.core_pattern is often a bare `core`, so a crashing test or a
# hand-run reproducer drops one wherever it was started from -- which is usually here.
# scripts/mutate/mutate.py sets RLIMIT_CORE to 0 for what it spawns; this is for everything else.
core
core.*
